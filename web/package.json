{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:quad": "node scripts/open-quad-room.mjs",
    "dev:battle": "node scripts/open-test-battle.mjs",
    "dev:duo": "node scripts/open-duo-battle.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:room": "playwright test -c e2e/playwright.config.ts tests/room",
    "test:e2e:skills": "playwright test -c e2e/playwright.harness.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.0",
    "gsap": "^3.15.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.24",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.1.4"
  }
}
